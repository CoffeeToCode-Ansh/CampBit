# ==============================================================================
# CampBit Environment Variables
# ==============================================================================

# Database Configuration:
# - Leave blank or unset for local development with local SQLite (app.db)
# - Set to Render Free PostgreSQL external or internal URL when deployed:
#   Example: postgresql://campbit_user:secret@dpg-xxxx.oregon-postgres.render.com/campbit
DATABASE_URL=

# Application Secret Key:
# - Leave blank to auto-generate and persist in .secret
# - In production (Render), generate a 64-character secret and set it here:
SECRET_KEY=

# Inbound SMS Gateway Webhook Secret:
# - Protects /api/sms/inbound from unauthorized carrier spoofing
# - External gateways (e.g., Twilio, MSG91) must provide this in the 'X-SMS-Secret' header
SMS_WEBHOOK_SECRET=

# Initial Admin Credentials (used only if database is completely empty on first boot):
ADMIN_EMAIL=admin@college.example
ADMIN_PASSWORD=
